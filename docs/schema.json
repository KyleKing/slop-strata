{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "slop-strata JSON envelope",
  "description": "Every --json output: one envelope wrapping a change, snapshot, history, or rules result. Schema version 6. Each metric's meaning is in docs (the same text as --explain).",
  "type": "object",
  "required": ["result", "docs", "tool", "command", "repo", "at", "counts", "schema"],
  "additionalProperties": false,
  "properties": {
    "result": {"description": "The command's result, or null on a failed pair of change --pairs."},
    "docs": {"type": "object", "additionalProperties": {"type": "string"}},
    "tool": {"const": "slop-strata"},
    "command": {"enum": ["change", "snapshot", "history", "rules"]},
    "repo": {"type": "string"},
    "at": {"type": "string", "format": "date-time"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "error": {"type": "string", "description": "Set only on a pair that could not be scored."},
    "counts": {"$ref": "#/$defs/counts"},
    "schema": {"const": 6}
  },
  "allOf": [
    {
      "if": {"properties": {"command": {"const": "change"}}, "required": ["command"]},
      "then": {"properties": {"result": {"anyOf": [{"$ref": "#/$defs/changeResult"}, {"type": "null"}]}}}
    },
    {
      "if": {"properties": {"command": {"const": "snapshot"}}, "required": ["command"]},
      "then": {"properties": {"result": {"$ref": "#/$defs/snapshotResult"}}}
    },
    {
      "if": {"properties": {"command": {"const": "history"}}, "required": ["command"]},
      "then": {"properties": {"result": {"$ref": "#/$defs/historyResult"}}}
    },
    {
      "if": {"properties": {"command": {"const": "rules"}}, "required": ["command"]},
      "then": {"properties": {"result": {"$ref": "#/$defs/rulesResult"}}}
    }
  ],
  "$defs": {
    "counts": {
      "description": "Files the run could not score, and findings it set aside. A non-zero errors or skipped count means the numbers cover less of the tree.",
      "type": "object",
      "required": ["errors", "skipped", "suppressed", "stale_baseline"],
      "additionalProperties": false,
      "properties": {
        "errors": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "stale_baseline": {"type": "integer", "minimum": 0, "description": "Baseline entries no finding of the snapshot carries the id of; see the stale_baseline doc. Always zero on change and history, which do not score the whole tree against the baseline."},
        "suppressed": {
          "description": "Findings set aside, each counted once under the first of ignored, labeled_fp, and baseline. Always zero on history.",
          "type": "object",
          "required": ["baseline", "ignored", "labeled_fp"],
          "additionalProperties": false,
          "properties": {
            "baseline": {"type": "integer", "minimum": 0, "description": "Accepted in the baseline file."},
            "ignored": {"type": "integer", "minimum": 0, "description": "Covered by an inline slop-strata:ignore or nolint comment with a reason."},
            "labeled_fp": {"type": "integer", "minimum": 0, "description": "Labeled a false positive in the labels file."}
          }
        }
      }
    },
    "rulesResult": {
      "type": "object",
      "required": ["labels", "rules"],
      "additionalProperties": false,
      "properties": {
        "labels": {"type": "string", "description": "The labels file the counts come from, relative to the repository root."},
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule", "tier", "precision", "tp", "fp", "n", "provisional"],
            "additionalProperties": false,
            "properties": {
              "rule": {"type": "string"},
              "tier": {"enum": ["default", "experimental", "external"], "description": "external marks a rule that only the labels file names, such as an ast-grep rule."},
              "precision": {"type": ["number", "null"], "description": "tp over n, null when no finding of the rule is labeled."},
              "tp": {"type": "integer", "minimum": 0},
              "fp": {"type": "integer", "minimum": 0},
              "n": {"type": "integer", "minimum": 0, "description": "Labeled findings, tp plus fp."},
              "provisional": {"type": "boolean", "description": "True under 10 labels."}
            }
          }
        }
      }
    },
    "skippedRow": {
      "type": "object",
      "required": ["path", "reason"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string"},
        "reason": {"type": "string", "description": "Why the file was skipped (config-skip, oversize, binary, minified, generated, unsupported), or a parse error's text, which names the byte share under error nodes."}
      }
    },
    "findingRow": {
      "type": "object",
      "required": ["id", "path", "rule", "line", "new"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "description": "Ten hex characters hashed from the rule, path, enclosing function, matched text, line text, and an occurrence index. Survives line moves."},
        "path": {"type": "string"},
        "rule": {"type": "string"},
        "match": {"type": "string"},
        "note": {"type": "string", "description": "What a cross-file finding adds to its match, such as an import cycle's cheapest cut, or where the code an x/new-duplicate finding repeats is and how the two sites differ."},
        "line": {"type": "integer", "minimum": 0},
        "new": {"type": "boolean", "description": "True when the finding sits on a line the change added, or is a cross-file finding the change caused, such as a new or grown import cycle."}
      }
    },
    "fileDelta": {
      "type": "object",
      "required": ["path", "status", "mass_before", "mass_after", "mass_grown", "over_limit", "added", "deleted"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string"},
        "status": {"type": "string"},
        "lang": {"type": "string"},
        "mass_before": {"type": "number"},
        "mass_after": {"type": "number"},
        "mass_grown": {"type": "number"},
        "over_limit": {"type": "number"},
        "added": {"type": "integer", "minimum": 0},
        "deleted": {"type": "integer", "minimum": 0}
      }
    },
    "topFunction": {
      "type": "object",
      "required": ["file", "name", "line", "cc_before", "cc_after", "mass_before", "mass_after", "mass_grown", "test"],
      "additionalProperties": false,
      "properties": {
        "file": {"type": "string"},
        "name": {"type": "string"},
        "line": {"type": "integer", "minimum": 1, "description": "Start line on the after side."},
        "cc_before": {"type": "integer", "minimum": 0, "description": "0 for a new function."},
        "cc_after": {"type": "integer", "minimum": 0},
        "mass_before": {"type": "number"},
        "mass_after": {"type": "number"},
        "mass_grown": {"type": "number"},
        "test": {"type": "boolean", "description": "True when the file is a test file."}
      }
    },
    "nextItem": {
      "type": "object",
      "required": ["kind", "reason"],
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["grown_function", "new_finding", "intent_mismatch"]},
        "file": {"type": "string", "description": "Absent for intent_mismatch."},
        "line": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "description": "The function, for grown_function."},
        "rule": {"type": "string", "description": "The rule id, for new_finding."},
        "reason": {"type": "string", "description": "One sentence built from the numbers."}
      }
    },
    "intent": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string", "enum": ["feat", "fix", "refactor", "perf", "test", "docs", "chore", "unknown"]},
        "scope": {"type": "string"},
        "summary": {"type": "string"},
        "revert": {"type": "boolean"}
      }
    },
    "changeResult": {
      "type": "object",
      "required": ["base", "end", "reading", "intent", "findings", "files", "top_functions", "next", "delta", "dirs", "surface_widened"],
      "properties": {
        "base": {"type": "string", "description": "Commit the change diffs from."},
        "end": {"type": "string"},
        "reading": {"type": "string", "description": "One sentence over the numbers, from rules, never a model."},
        "intent": {"$ref": "#/$defs/intent"},
        "findings": {"type": ["array", "null"], "items": {"$ref": "#/$defs/findingRow"}},
        "errors": {"type": "array", "items": {"$ref": "#/$defs/skippedRow"}},
        "skipped": {"type": "array", "items": {"$ref": "#/$defs/skippedRow"}},
        "files": {"type": "array", "items": {"$ref": "#/$defs/fileDelta"}, "description": "Every changed file, an empty array when the change touched none."},
        "top_functions": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/topFunction"}, "description": "Functions the change grew, largest mass_grown first; see the top_functions doc."},
        "next": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/nextItem"}, "description": "Where to look first, in a fixed order; empty when the change is not worth a look. See the next doc."},
        "surface_widened": {
          "description": "Directories whose surface the change widened; see the surface_widened doc. Never read by next.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["dir", "newly_shown", "newly_shown_count", "newly_shown_by_name", "shown_before", "shown_after", "depth_before", "depth_after"],
            "additionalProperties": false,
            "properties": {
              "dir": {"type": "string"},
              "newly_shown": {"type": "array", "maxItems": 5, "items": {"type": "string"}, "description": "Names attributed uses from other directories reach now and did not before, sorted, at most five. Never a method matched by name."},
              "newly_shown_count": {"type": "integer", "minimum": 1},
              "newly_shown_by_name": {"type": "integer", "minimum": 0, "description": "Methods matched by name now and not before: counted, unverified, never listed."},
              "shown_before": {"type": "integer", "minimum": 0, "description": "Attributed shown names before."},
              "shown_after": {"type": "integer", "minimum": 1, "description": "Attributed shown names after."},
              "depth_before": {"type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "depth_attributed before."},
              "depth_after": {"type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "depth_attributed after."}
            }
          }
        },
        "delta": {
          "type": "object",
          "required": ["mass_removed", "mass_net", "mass_grown", "over_limit", "test_mass_removed", "test_mass_net", "test_mass_grown", "test_over_limit", "erosion_before", "erosion_after", "lines_added", "lines_deleted"],
          "properties": {
            "mass_grown": {"type": "number", "description": "Gross mass the change added to production functions; see the mass_grown doc."},
            "mass_removed": {"type": "number", "description": "Gross mass the change removed from production functions; see the mass_removed doc."},
            "mass_net": {"type": "number", "description": "mass_grown minus mass_removed."},
            "over_limit": {"type": "number", "description": "The part of mass_grown in functions over CC 10."},
            "test_mass_grown": {"type": "number", "description": "mass_grown for test files."},
            "test_mass_removed": {"type": "number", "description": "mass_removed for test files."},
            "test_mass_net": {"type": "number", "description": "test_mass_grown minus test_mass_removed."},
            "test_over_limit": {"type": "number", "description": "over_limit for test files."},
            "erosion_before": {"type": "number"},
            "erosion_after": {"type": "number"},
            "lines_added": {"type": "integer"},
            "lines_deleted": {"type": "integer"}
          }
        },
        "dirs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["mass_net", "erosion_before", "erosion_after", "hotspot"],
            "properties": {
              "mass_net": {"type": "number"},
              "erosion_before": {"type": "number"},
              "erosion_after": {"type": "number"},
              "hotspot": {"type": "boolean"},
              "provisional": {"type": "boolean", "description": "Set when either side has under 5 functions; text output marks the erosion with *."}
            }
          }
        },
        "context": {"type": "object", "description": "Present with --context: hunks, snippets (finding lines and the source lines of each next function, up to 80 each), crossed functions, messages."}
      }
    },
    "aggregates": {
      "type": "object",
      "required": ["erosion", "mass", "func_count", "files", "over_50"],
      "properties": {
        "erosion": {"type": "number"},
        "mass": {"type": "number"},
        "tables": {"type": "integer"},
        "table_mass": {"type": "number"},
        "func_count": {"type": "integer"},
        "files": {"type": "integer"},
        "files_parse_error": {"type": "integer"},
        "over_50": {"type": "integer"},
        "p90_len": {"type": "integer"},
        "max_len": {"type": "integer"},
        "p90_nesting": {"type": "integer"},
        "max_nesting": {"type": "integer"},
        "p90_params": {"type": "integer"},
        "max_params": {"type": "integer"},
        "p90_cognitive": {"type": "integer"},
        "max_cognitive": {"type": "integer"}
      }
    },
    "snapshotDir": {
      "type": "object",
      "required": ["dir", "files", "erosion", "mass", "table_mass", "funcs", "over_50", "touches_90d", "hotspot", "findings", "fan_in", "fan_out", "shown", "hidden", "shown_mass", "hidden_mass", "forwarders", "depth", "depth_attributed", "depth_by_mass", "shown_by_name", "shown_mass_by_name", "widest_shown"],
      "properties": {
        "dir": {"type": "string"},
        "files": {"type": "integer"},
        "erosion": {"type": "number"},
        "mass": {"type": "number"},
        "table_mass": {"type": "number"},
        "funcs": {"type": "integer"},
        "over_50": {"type": "integer"},
        "touches_90d": {"type": "integer", "description": "Commits that touched the directory in the 90 days ending at the scored revision; see the touches_90d doc."},
        "hotspot": {"type": "number", "description": "touches_90d times mass; see the hotspot doc."},
        "findings": {"type": "integer"},
        "fan_in": {"type": "integer", "minimum": 0, "description": "Distinct other directories whose files import this one's; see the fan_in doc."},
        "fan_out": {"type": "integer", "minimum": 0, "description": "Distinct other directories this one's files import; see the fan_out doc."},
        "shown": {"type": "integer", "minimum": 0, "description": "Declared names a production file of another directory uses; see the shown doc. Zero on a test directory's row, as are the other depth fields."},
        "hidden": {"type": "integer", "minimum": 0, "description": "Declared names no other directory uses; see the hidden doc."},
        "shown_mass": {"type": "number", "minimum": 0, "description": "Complexity mass behind the shown names; see the shown_mass doc."},
        "hidden_mass": {"type": "number", "minimum": 0, "description": "Complexity mass behind the hidden names and of functions no declaration holds; see the hidden_mass doc."},
        "forwarders": {"type": "integer", "minimum": 0, "description": "Pass-through functions, counted in neither shown nor hidden; see the forwarders doc."},
        "depth": {"type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "hidden over shown plus hidden, by mass or by count; null when shown is 0. See the depth doc."},
        "depth_attributed": {"type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "depth with methods matched by name counted as hidden, the upper bound; null when no use is attributed. See the depth_attributed doc."},
        "shown_by_name": {"type": "integer", "minimum": 0, "description": "How many of shown are methods matched by name alone, an unverified upper bound; see the shown_by_name doc."},
        "shown_mass_by_name": {"type": "number", "minimum": 0, "description": "How much of shown_mass those methods carry."},
        "depth_by_mass": {"type": "boolean", "description": "True when depth is a ratio of mass, false when it is a ratio of name counts or null."},
        "depth_provisional": {"type": "boolean", "description": "Set when depth is read off fewer than 5 names."},
        "widest_file": {"type": "string", "description": "The file with the most shown names; absent when shown is 0. See the widest_surface doc."},
        "widest_shown": {"type": "integer", "minimum": 0, "description": "How many shown names widest_file declares."},
        "provisional": {"type": "boolean"}
      }
    },
    "snapshotResult": {
      "type": "object",
      "required": ["rev", "dirs", "files", "top_functions", "findings", "total", "imports"],
      "properties": {
        "rev": {"type": "string"},
        "dirs": {"type": "array", "items": {"$ref": "#/$defs/snapshotDir"}},
        "test_dirs": {
          "description": "Directories of test files, ranked among themselves and kept out of dirs.",
          "type": "array", "items": {"$ref": "#/$defs/snapshotDir"}
        },
        "files": {
          "description": "Every scored file, production files first, ranked by hotspot, then mass.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sloc", "funcs", "mass", "tables", "table_mass", "erosion", "over_50", "max_cc", "findings", "touches_90d", "hotspot"],
            "properties": {
              "path": {"type": "string"},
              "test": {"type": "boolean"},
              "sloc": {"type": "integer"},
              "funcs": {"type": "integer"},
              "mass": {"type": "number"},
              "tables": {"type": "integer"},
              "table_mass": {"type": "number"},
              "erosion": {"type": "number"},
              "over_50": {"type": "integer"},
              "max_cc": {"type": "integer"},
              "findings": {"type": "integer"},
              "touches_90d": {"type": "integer"},
              "hotspot": {"type": "number", "description": "touches_90d times mass."}
            }
          }
        },
        "top_functions": {
          "description": "The 10 heaviest functions of the tree by mass, tests included and flagged; see the top_functions doc.",
          "type": "array", "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["file", "name", "line", "cc", "sloc", "mass", "test"],
            "additionalProperties": false,
            "properties": {
              "file": {"type": "string"},
              "name": {"type": "string"},
              "line": {"type": "integer", "minimum": 1},
              "cc": {"type": "integer"},
              "sloc": {"type": "integer"},
              "mass": {"type": "number"},
              "test": {"type": "boolean"}
            }
          }
        },
        "findings": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rule", "id", "line"],
              "properties": {
                "rule": {"type": "string"},
                "id": {"type": "string", "description": "Ten hex characters hashed from the rule, path, scope, matched text, line text, and an occurrence index. Survives line moves."},
                "line": {"type": "integer"},
                "match": {"type": "string"},
                "scope": {"type": "string", "description": "The enclosing function, when the rule reads one."},
                "anchor": {"type": "string", "description": "Eight hex characters hashed from the trimmed text of the finding's line. Part of the id."},
                "note": {"type": "string"},
                "members": {"type": "array", "items": {"type": "string"}, "description": "On a set-shaped finding such as x/import-cycle, the sorted files that key it. The id is then hashed from the rule and these alone."}
              }
            }
          }
        },
        "total": {"$ref": "#/$defs/aggregates"},
        "imports": {
          "type": "object",
          "description": "The resolved import graph of the tree; see the import_edges and import_cycles docs.",
          "required": ["edges", "type_edges", "deferred_edges", "cycles", "largest_cycle"],
          "additionalProperties": false,
          "properties": {
            "edges": {"type": "integer", "minimum": 0, "description": "File-to-file imports resolved inside the tree, of every kind."},
            "type_edges": {"type": "integer", "minimum": 0, "description": "Of edges, the ones only a type checker reads."},
            "deferred_edges": {"type": "integer", "minimum": 0, "description": "Of edges, the ones inside a function body, a dynamic import(), or a Python main guard."},
            "cycles": {"type": "integer", "minimum": 0, "description": "Groups of two or more non-test files that import each other at module level."},
            "largest_cycle": {"type": "integer", "minimum": 0, "description": "Files in the largest such group, or 0 with none."}
          }
        },
        "skipped": {"type": "array", "items": {"$ref": "#/$defs/skippedRow"}},
        "errors": {"type": "array", "items": {"$ref": "#/$defs/skippedRow"}}
      }
    },
    "deaths": {
      "type": "object",
      "description": "Lines that died within 30 days of being written, so total equals churn_30d. self, pure, whole_file, and in_revert are independent splits of total, and the three age buckets partition it. Moved lines are not deaths.",
      "required": ["total", "self", "pure", "whole_file", "in_revert", "age_le_1d", "age_2_7d", "age_8_30d", "readd_at_risk", "readded", "readded_by_revert"],
      "properties": {
        "total": {"type": "integer"},
        "self": {"type": "integer", "description": "Removed by the commit author who wrote the line."},
        "pure": {"type": "integer", "description": "Removed in a hunk that added no lines, or with a deleted file."},
        "whole_file": {"type": "integer", "description": "Died with a deleted file."},
        "in_revert": {"type": "integer", "description": "Removed by a commit that reverts another change."},
        "age_le_1d": {"type": "integer"},
        "age_2_7d": {"type": "integer"},
        "age_8_30d": {"type": "integer"},
        "readd_at_risk": {"type": "integer", "description": "Deaths of lines of 30 or more bytes that had 30 days of walk after them, the denominator of the readd share."},
        "readded": {"type": "integer", "description": "Of readd_at_risk, deaths a later commit added back to the same file within 30 days, excluding revert-related ones."},
        "readded_by_revert": {"type": "integer", "description": "Of readd_at_risk, deaths in a revert commit or added back by one."},
        "by_class": {
          "type": "object",
          "description": "Birth author class, then the class of the removing commit, then a count.",
          "additionalProperties": {"type": "object", "additionalProperties": {"type": "integer"}}
        }
      }
    },
    "historyResult": {
      "type": "object",
      "required": ["range", "changes", "lineage", "oscillation", "weeks", "virality", "pairing", "hotspots", "architecture"],
      "properties": {
        "range": {"type": "string"},
        "changes": {"type": "integer", "description": "First-parent commits in the window."},
        "lineage": {
          "type": "object",
          "required": ["commits", "authors", "reverts", "deaths_30d", "dirs", "survival", "test_survival", "coupling", "concentration"],
          "properties": {
            "commits": {"type": "integer"},
            "authors": {"type": "integer", "description": "Distinct commit author emails in the window. With 1, every death's self share is trivially 1."},
            "reverts": {"type": "integer"},
            "deaths_30d": {"$ref": "#/$defs/deaths"},
            "dirs": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {"deaths_30d": {"$ref": "#/$defs/deaths"}}
              }
            },
            "survival": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["cohort", "added", "surviving", "s_30d", "s_90d"],
                "properties": {
                  "cohort": {"type": "string"},
                  "added": {"type": "integer"},
                  "surviving": {"type": "integer"},
                  "s_30d": {"type": ["number", "null"]},
                  "s_90d": {"type": ["number", "null"]}
                }
              }
            },
            "test_survival": {"type": "array"},
            "coupling": {"type": ["array", "null"]},
            "concentration": {"type": "object", "additionalProperties": {"type": ["number", "null"]}}
          }
        },
        "oscillation": {
          "type": "object",
          "description": "Functions whose body changed in at least 3 commits within 14 days, keyed by path and name. Bot-class commits do not count.",
          "required": ["oscillating_funcs", "oscillating_test_funcs", "dirs", "top"],
          "properties": {
            "oscillating_funcs": {"type": "integer", "description": "Production functions."},
            "oscillating_test_funcs": {"type": "integer", "description": "Functions in test files."},
            "dirs": {
              "type": "object",
              "description": "Only directories with at least one oscillating function.",
              "additionalProperties": {
                "type": "object",
                "required": ["oscillating_funcs", "oscillating_test_funcs"],
                "properties": {
                  "oscillating_funcs": {"type": "integer"},
                  "oscillating_test_funcs": {"type": "integer"}
                }
              }
            },
            "top": {
              "type": "array",
              "description": "Up to 10 production functions, most changes first, then shortest span.",
              "items": {
                "type": "object",
                "required": ["path", "name", "line", "changes", "span_days"],
                "properties": {
                  "path": {"type": "string"},
                  "name": {"type": "string"},
                  "line": {"type": "integer", "description": "Start line in the function's latest version."},
                  "changes": {"type": "integer", "description": "Most commits that changed it within any 14 days."},
                  "span_days": {"type": "integer", "description": "Days from the first to the last of those commits."}
                }
              }
            }
          }
        },
        "weeks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["week", "commits", "kinds", "added", "removed", "mass_net"],
            "properties": {
              "week": {"type": "string", "format": "date"},
              "commits": {"type": "integer"},
              "kinds": {"type": "object", "additionalProperties": {"type": "integer"}},
              "added": {"type": "integer"},
              "removed": {"type": "integer"},
              "mass_net": {"type": "number"}
            }
          }
        },
        "virality": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule", "first_week", "hits_by_class", "spread_dirs"],
            "properties": {
              "rule": {"type": "string"},
              "first_week": {"type": "string"},
              "hits_by_class": {"type": "object", "additionalProperties": {"type": "integer"}},
              "spread_dirs": {"type": "integer"}
            }
          }
        },
        "pairing": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["week", "dir", "class_mass_net", "class_commits", "provisional"],
            "properties": {
              "week": {"type": "string"},
              "dir": {"type": "string"},
              "class_mass_net": {"type": "object", "additionalProperties": {"type": "number"}},
              "class_commits": {"type": "object", "additionalProperties": {"type": "integer"}},
              "class_churn": {"type": "object", "additionalProperties": {"type": "integer"}},
              "provisional": {"type": "boolean"}
            }
          }
        },
        "hotspots": {"type": "object", "additionalProperties": {"type": "number"}},
        "architecture": {"$ref": "#/$defs/architecture"}
      }
    },
    "architecture": {
      "type": "object",
      "description": "How the inferred import graph changed over the window; see the architecture doc. Metrics only: nothing here is a finding or feeds a gate. Every list is empty when the window has no commit.",
      "required": ["periods", "depth_moved", "cycles", "hidden_coupling"],
      "additionalProperties": false,
      "properties": {
        "periods": {
          "type": "array",
          "description": "One row per week with a commit, oldest first, read from the tree after the week's last first-parent commit.",
          "items": {
            "type": "object",
            "required": ["week", "rev", "cycles", "largest_cycle", "files_in_cycles", "depth_dirs", "median_depth", "median_depth_attributed"],
            "additionalProperties": false,
            "properties": {
              "week": {"type": "string", "format": "date", "description": "The Monday of the week."},
              "rev": {"type": "string", "description": "The commit whose tree was read."},
              "cycles": {"type": "integer", "minimum": 0, "description": "Import cycles, as result.imports.cycles on snapshot."},
              "largest_cycle": {"type": "integer", "minimum": 0},
              "files_in_cycles": {"type": "integer", "minimum": 0, "description": "Files in any cycle; see the files_in_cycles doc."},
              "depth_dirs": {"type": "integer", "minimum": 0, "description": "Directories with a depth read off at least 5 names; see the depth_dirs doc."},
              "median_depth": {"type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "Median depth of those directories, null with none; see the median_depth doc."},
              "median_depth_attributed": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
            }
          }
        },
        "depth_moved": {
          "type": "array",
          "description": "Up to 5 directories whose depth moved most from the first week to the last; see the depth_moved doc.",
          "items": {
            "type": "object",
            "required": ["dir", "depth_from", "depth_to", "depth_attributed_from", "depth_attributed_to", "moved"],
            "additionalProperties": false,
            "properties": {
              "dir": {"type": "string"},
              "depth_from": {"type": "number"},
              "depth_to": {"type": "number"},
              "depth_attributed_from": {"type": "number"},
              "depth_attributed_to": {"type": "number"},
              "moved": {"type": "number", "description": "The smaller of the depth move and the depth_attributed move, signed."}
            }
          }
        },
        "cycles": {
          "type": "array",
          "description": "Each import cycle of the last week and where it came from, largest first; see the cycle_origin doc.",
          "items": {
            "type": "object",
            "required": ["id", "members", "size", "first_week", "first_size", "before_window", "introduced"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "description": "The id of the cycle's x/import-cycle finding at the last week's rev."},
              "members": {"type": "array", "items": {"type": "string"}, "description": "The sorted files the id is hashed over: every member, less the files that only re-export when two others remain."},
              "size": {"type": "integer", "minimum": 2, "description": "Every file of the cycle."},
              "first_week": {"type": "string", "description": "The week the cycle first appeared in, empty when before_window is set."},
              "first_size": {"type": "integer", "minimum": 2, "description": "Its files that week, or in the tree before the window."},
              "before_window": {"type": "boolean", "description": "The cycle is older than the window, or the tree before the window could not be read."},
              "introduced": {
                "type": ["object", "null"],
                "description": "The first-parent commit the cycle is first present after, null when before_window is set.",
                "required": ["commit", "author_class", "intent"],
                "additionalProperties": false,
                "properties": {
                  "commit": {"type": "string"},
                  "author_class": {"type": "string", "description": "The configured class of the commit: person, agent, bot, or a repository's own."},
                  "intent": {"type": "string", "description": "The commit's stated intent, such as feat, fix, refactor, or unknown."}
                }
              }
            }
          }
        },
        "hidden_coupling": {
          "type": "array",
          "description": "Up to 10 pairs of files that change together with no chain of imports between them, best supported first; see the hidden_coupling doc.",
          "items": {
            "type": "object",
            "required": ["a", "b", "co_changes", "changes_a", "changes_b", "support", "confidence", "shared_importer"],
            "additionalProperties": false,
            "properties": {
              "a": {"type": "string"},
              "b": {"type": "string"},
              "co_changes": {"type": "integer", "minimum": 4, "description": "Commits that changed both and no file both import."},
              "changes_a": {"type": "integer", "minimum": 1},
              "changes_b": {"type": "integer", "minimum": 1},
              "support": {"type": "number", "minimum": 1.5, "description": "co_changes weighed by how few other files each commit changed; see the support doc."},
              "confidence": {"type": "number", "minimum": 0.5, "maximum": 1, "description": "co_changes over the smaller of changes_a and changes_b."},
              "shared_importer": {"type": "boolean", "description": "Some file imports both."}
            }
          }
        }
      }
    }
  }
}
